# ============================================================
#  MMA NHANVATAI — Tạo nhân vật ảo tự động
#  Copy file này thành .env rồi điền giá trị thật
# ============================================================

# ── Server ──────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8077
# Cho phép web dev (Vite) gọi API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Blender (engine 3D, tuỳ chọn) ───────────────────────────
# Bỏ trống -> tự dò "C:\Program Files\Blender Foundation\*\blender.exe"
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# Giây tối đa cho 1 lần dựng nhân vật
BLENDER_TIMEOUT=240

# ── AI tạo ảnh chân dung (chân dung 2D) ─────────────────────
# Ưu tiên 1: Google AI Studio (Gemini) — miễn phí 500 request/ngày
# Lấy key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Ưu tiên 2: MeToken (OpenAI-compatible)
METOKEN_API_KEY=
METOKEN_IMAGE_MODEL=gpt-image-2
# Đổi nếu nhà cung cấp của anh dùng domain khác (API tương thích OpenAI)
METOKEN_BASE_URL=https://api.metoken.ai/v1

# Ưu tiên 3 (mặc định, KHÔNG cần key): Pollinations.ai
PORTRAIT_ALLOW_POLLINATIONS=true
# Giây tối đa cho 1 lần vẽ ảnh (Pollinations có thể chậm)
PORTRAIT_TIMEOUT=180

# ── LLM DeepSeek (viết lại prompt ảnh + nâng cấp hồ sơ) ─────
# Lấy key: https://platform.deepseek.com/api_keys  (API tương thích OpenAI)
# Có key -> /api/portrait/ai dùng DeepSeek viết lại prompt tiếng Anh trước khi vẽ,
#           và mở khoá thêm endpoint POST /api/ai/character.
# Không có key -> web vẫn vẽ ảnh bình thường bằng prompt do Character Engine sinh.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=90

# ── Blender: cầu nối trực tiếp (tuỳ chọn, kiểu MCP Blender) ──
# Addon api/blender_addon/mma_bridge.py mở socket trong Blender ĐANG MỞ để dựng
# nhân vật ngay tại chỗ (xem api/README.md). Mặc định 127.0.0.1:9876.
BLENDER_BRIDGE_HOST=127.0.0.1
BLENDER_BRIDGE_PORT=9876

# ── Thư viện nhân vật ──────────────────────────────────────
# Thư mục lưu nhân vật trên server (để trống -> api/data/library.json)
LIBRARY_DIR=

# ── Web (Vite) ─────────────────────────────────────────────
# Địa chỉ API cho web dev; bỏ trống -> web gọi http://127.0.0.1:8077
VITE_API_BASE=http://127.0.0.1:8077
